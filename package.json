{
  "name": "albon_monitoring_framework",
  "version": "2.0.0",
  "description": "ALBON Monitoring Framework with Express REST API, WebSocket Server, and Native React Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:server": "node server.js",
    "start:web": "react-scripts start",
    "start:electron": "electron .",
    "dev": "concurrently \"npm run start:server\" \"npm run start:web\"",
    "dev:electron": "concurrently \"npm run start:electron\" \"npm run start:web\"",
    "seed": "node scripts/seed-users.js",
    "build": "react-scripts build",
    "build:web": "react-scripts build",
    "build:electron": "electron-builder",
    "switch-db": "node scripts/switch-db.js",
    "test": "react-scripts test"
  },
  "author": "alprog_boncos",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^36.2.1",
    "firebase-tools": "^13.35.1"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "firebase": "^11.9.0",
    "firebase-admin": "^12.7.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "serialport": "^13.0.0",
    "ws": "^8.18.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
